{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "site",
  "cleanUrls": false,
  "redirects": [
    { "source": "/css", "destination": "/css/", "permanent": true },
    { "source": "/basic", "destination": "/basic/", "permanent": true },
    { "source": "/hybrid", "destination": "/hybrid/", "permanent": true },
    { "source": "/compare", "destination": "/compare/", "permanent": true },
    { "source": "/bench", "destination": "/bench/", "permanent": true },
    { "source": "/original", "destination": "/original/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/css/index.html", "destination": "/css/", "permanent": true },
    { "source": "/basic/index.html", "destination": "/basic/", "permanent": true },
    { "source": "/hybrid/index.html", "destination": "/hybrid/", "permanent": true },
    { "source": "/compare/index.html", "destination": "/compare/", "permanent": true },
    { "source": "/bench/index.html", "destination": "/bench/", "permanent": true },
    { "source": "/original/index.html", "destination": "/original/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/original/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/hybrid/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'none'; object-src 'none'; font-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'" }
      ]
    },
    {
      "source": "/basic/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'none'; object-src 'none'; font-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'" }
      ]
    },
    {
      "source": "/source/svg",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"the-twelve-svg.html\"" }
      ]
    },
    {
      "source": "/source/css",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"the-twelve-css-polygons.html\"" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'none'; object-src 'none'; font-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'" }
      ]
    },
    {
      "source": "/source/basic",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"the-twelve-css-primitives.html\"" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'none'; object-src 'none'; font-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'" }
      ]
    },
    {
      "source": "/source/hybrid",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"the-twelve-studio.zip\"" }
      ]
    },
    {
      "source": "/reference",
      "headers": [
        { "key": "Content-Type", "value": "image/png" }
      ]
    }
  ]
}
