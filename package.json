{
  "name": "twelve-card-studies",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Twelve football cards in four preserved editions: SVG, CSS polygons, CSS basic primitives, and hybrid artwork with editable HTML fields and reproducible browser benchmarks.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node build.mjs",
    "assets:hybrid": "node hybrid-art/prepare-assets.mjs",
    "build:hybrid": "node hybrid-art/build.mjs",
    "check:hybrid": "node benchmarks/hybrid-checks.mjs",
    "benchmark:four": "node benchmarks/four-run.mjs",
    "report:four": "node benchmarks/four-build-report.mjs --preview",
    "benchmark": "node benchmarks/run.mjs",
    "benchmark:webkit": "node benchmarks/run.mjs --webkit",
    "benchmark:features": "node benchmarks/run.mjs --features",
    "report": "node benchmarks/build-report.mjs",
    "check": "node benchmarks/capture.mjs",
    "check:webkit": "node benchmarks/capture.mjs --webkit",
    "build:vercel": "node scripts/build-vercel.mjs",
    "preview": "node scripts/preview.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "build:revision2": "node revision-2/build.mjs && node revision-2/build-hub.mjs",
    "assets:revision2": "node revision-2/prepare-assets.mjs",
    "check:revision2": "node revision-2/check.mjs",
    "benchmark:revision2": "node revision-2/benchmarks/run.mjs",
    "report:revision2": "node revision-2/benchmarks/report.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "24.x"
  }
}
